<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Details"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EVENT NAME"
            android:textColor="#777777"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading event..."
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE THIS CODE TO INVITE PEOPLE"
            android:textColor="#777777"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJoinCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--------"
            android:textColor="#7048E8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:padding="20dp"
            android:layout_marginTop="8dp"
            android:background="#F2EEFF" />

        <Button
            android:id="@+id/btnCopyCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Invite Code"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OR SCAN TO JOIN"
            android:textColor="#777777"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="28dp" />

        <ImageView
            android:id="@+id/ivJoinQRCode"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:contentDescription="Event invitation QR code"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan this code to join the event"
            android:textColor="#777777"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvMemberCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members: 1"
            android:textColor="#444444"
            android:textSize="16sp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpenGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Gallery"
            android:textAllCaps="false"
            android:backgroundTint="#7048E8"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnLeaveEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Leave Event"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="#D32F2F" />

    </LinearLayout>

</ScrollView>